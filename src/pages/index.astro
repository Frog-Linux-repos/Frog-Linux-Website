---
import Layout from "../layouts/Layout.astro";
import Pond from "../components/Pond.astro";
import DownloadIcon from "../assets/icons/download.svg";
---

<Layout title="Try Frog Linux">
  <Pond />
  <header>
    <div class="header">
      <div class="title">
        <h1>Try <u>Frog Linux</u></h1>
        <p>
          What does the buzzword 'technologies' really mean? Think granular. Our
          infinitely reconfigurable feature set is unparalleled in the industry,
          but our capability to upgrade.
        </p>
      </div>
      <div class="cta">
        <a href="/download" class="button primary">Download <DownloadIcon /></a>
        <a href="#main" class="button secondary">About</a>
      </div>
    </div>
  </header>
</Layout>

<style>
  header {
    justify-content: end;
    align-items: start;
    min-height: 100vh;
  }

  .header {
    max-width: 48rem;
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .title {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .title p {
    font-size: 1.5rem;
  }

  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }
</style>
