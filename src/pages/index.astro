---
import Layout from "../layouts/Layout.astro";
import Pond from "../components/Pond.astro";
---

<Layout title="Try Frog Linux">
  <Pond />
  <header>
    <div class="title">
      <div class="heading">
        <h1>Try <u>Frog Linux</u></h1>
        <p>
          What does the buzzword 'technologies' really mean? Think granular. Our
          infinitely reconfigurable feature set is unparalleled in the industry,
          but our capability to upgrade.
        </p>
      </div>
      <div class="cta">
        <a href="/download" class="button primary">Download</a>
        <a href="#main" class="button secondary">About</a>
      </div>
    </div>
  </header>
</Layout>

<style>
  header {
    justify-content: end;
    align-items: start;
    min-height: 100vh;
  }

  .title {
    max-width: 48rem;
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .heading h1 {
    font-size: 5rem;
  }

  .heading u {
    position: relative;
    text-decoration: none;
    text-wrap: nowrap;
  }

  .heading u::before {
    content: "";
    background-image: url("/images/underline.svg");
    display: block;
    position: absolute;
    width: 100%;
    height: 100%;
    top: 100%;
    left: 0;
    pointer-events: none;
    background-size: contain;
    background-repeat: no-repeat;
    background-position: top;
  }

  .heading p {
    font-size: 1.5rem;
  }

  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }
</style>
