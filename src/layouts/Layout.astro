---
import { Font } from "astro:assets";
import "../styles/main.css";

const {
  title,
  description = "",
  site = "Frog Linux",
  author = "FoxedDev",
  locale = ["en", "US"],
  themeColor = "#aed1aa",
  icon = `${Astro.url.origin}/favicon.ico`,
  image = `${Astro.url.origin}/thumbnail.svg`,
  url = `${Astro.url}`,
} = Astro.props;
---

<!doctype html>
<html lang={`${locale[0]}-${locale[1]}`}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={author} />
    <meta name="theme-color" content={themeColor} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href={icon} type="image/x-icon" />

    <!-- OpenGraph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:url" content={url} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site} />
    <meta property="og:locale" content={`${locale[0]}_${locale[1]}`} />

    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />

    <!-- Discord Embed -->
    <script id="discord:component-embed" type="application/json">
      {
        "component": {
          "type": 17,
          "components": [
            {
              "type": 9,
              "components": [
                {
                  "type": 10,
                  "content": ""
                }
              ],
              "accessory": {
                "type": 11,
                "media": {
                  "url": "https://frog-linux.com/thumbnail.svg"
                },
                "description": "A stylized frog on a light green lily pad."
              }
            },
            {
              "type": 1,
              "components": [
                {
                  "type": 2,
                  "style": 1,
                  "label": "Download",
                  "url": "https://frog-linux.com/download"
                },
                {
                  "type": 2,
                  "style": 2,
                  "label": "About",
                  "url": "https://frog-linux.com/"
                }
              ]
            }
          ],
          "accent_color": 11456938
        }
      }
    </script>

    <!-- Fonts -->
    <Font cssVariable="--font-heading" />
    <Font cssVariable="--font-default" />
  </head>
  <body>
    <slot />
  </body>
</html>
