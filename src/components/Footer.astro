---
import GithubIcon from "../icons/github.svg";
import DiscordIcon from "../icons/discord.svg";
---

<footer>
  <div class="socials">
    <a href="/github" target="_blank">
      <GithubIcon class="icon" />
    </a>
    <a href="/discord" target="_blank">
      <DiscordIcon class="icon" />
    </a>
  </div>
  <ul class="no-marker">
    <li>
      <a href="/">Home</a>
    </li>
    <li>
      <a href="/download">Download</a>
    </li>
    <li>
      <a href="/source" target="_blank">Source Code</a>
    </li>
  </ul>
  <ul class="no-marker">
    <li>
      Logo by <a
        href="https://mastodon.social/@Someplaceunknown"
        target="_blank">Elaine</a
      >
    </li>
    <li>
      Website by <a href="https://foxed.dev/" target="_blank">FoxedDev</a>
    </li>
  </ul>
  <p>No AI was used in the making of this website.</p>
  <p>© 2026 Frog Linux</p>
</footer>

<style>
  footer {
    background-image: url("/images/footer_lilypad.svg");
    background-repeat: no-repeat;
    background-size: 100%;
    padding-top: 6rem;
  }

  .socials {
    display: flex;
    gap: 1rem;
    align-items: center;
    justify-content: center;
  }
</style>
