<div class="discord-members-badge badge-container">
  <span class="info badge">Loading member count...</span>
</div>

<script>
  import { makeDiscordMembersBadge } from "../scripts/discordMembersBadge/main";

  const badgeContainers = document.querySelectorAll(".discord-members-badge");
  badgeContainers.forEach((badgeContainer) => {
    if (badgeContainer instanceof HTMLDivElement)
      makeDiscordMembersBadge(badgeContainer);
  });
</script>
